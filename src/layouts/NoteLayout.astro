---
import BaseLayout from "./BaseLayout.astro";
import { writing } from "../data/writing";
import { formatDate } from "../data/site";
import type { MarkdownLayoutProps } from "astro";
type Props = MarkdownLayoutProps<{ slug: string }>;
const { frontmatter, headings } = Astro.props;
const post = writing.find(item => item.slug === frontmatter.slug);
if (!post) throw new Error("Missing writing metadata");
---
<BaseLayout title={post.title} description={post.description} article publishedDate={post.date}>
  <header class="page-hero">
    <a class="back-link" href="/writing/">All writing</a>
    <p class="page-label">{post.topic} · Working perspective</p>
    <h1>{post.title}</h1>
    <p class="lede">{post.description}</p>
    <div class="reading-meta"><span>Yunxi Kong</span><time datetime={post.date}>{formatDate(post.date)}</time><span>{post.minutes} min read</span></div>
  </header>
  <div class="article-shell">
    <article class="prose"><slot /><footer class="article-footer"><a href="/research/">Related research questions</a></footer></article>
    <nav class="article-toc" aria-label="In this note"><h2>In This Note</h2><ul>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>
  </div>
</BaseLayout>
