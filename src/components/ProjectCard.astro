---
import type { Project } from "../data/projects";

type Props = {
  project: Project;
  compact?: boolean;
};

const { project, compact = false } = Astro.props;
---

<article class:list={["project-card", compact && "compact-card", !project.thumbnail && "text-project"]}>
  {project.thumbnail && <a class="project-thumb" href={`/projects/${project.slug}/`} aria-label={`Open ${project.title}`}>
    <img src={project.thumbnail} alt="" width="640" height="400" loading="lazy" />
  </a>}
  <div class="project-card-body">
    <div class="card-meta">
      <span>{project.year}</span>
      <span>{project.status || project.category}</span>
    </div>
    <h3><a href={`/projects/${project.slug}/`}>{project.title}</a></h3>
    {project.role && <p class="project-role">{project.role}</p>}
    <p>{project.summary}</p>
    {!compact && <p class="methods-line">{project.methods.join(" · ")}</p>}
    <div class="card-actions">
      <a href={`/projects/${project.slug}/`}>Read project</a>
      {project.links?.slice(0, 1).map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>
  </div>
</article>
