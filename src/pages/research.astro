---
import BaseLayout from "../layouts/BaseLayout.astro";
import { methodGroups } from "../data/site";
const questions = [
  { title: "Human capability, not only task completion", question: "When does assistance improve a person's ability to understand, decide, and act, rather than only the immediate output?", text: "I am interested in interfaces that keep people involved in interpreting evidence, correcting systems, and developing expertise. Medical learning and historical inquiry offer concrete settings in which to study these interactions.", links: [{label:"ASNR Brain Atlas",href:"/projects/asnr-brain-atlas/"},{label:"Histy",href:"/projects/histy-ai-history-annotation/"},{label:"Research note",href:"/writing/human-capability/"}] },
  { title: "Agents in social environments", question: "How do information, incentives, and persistent consequences shape interactions among people and AI agents?", text: "My economics background motivates questions about coordination, information asymmetry, and institutions. Motiverse is an early system-building step: separating a character's words from changes to a shared world. Studying real social behavior will require additional validation beyond a convincing simulation.", links:[{label:"Motiverse",href:"/projects/motiverse/"},{label:"Research note",href:"/writing/simulation-and-evidence/"}] },
  { title: "Evidence for human-AI systems", question: "Which observations support a claim about human behavior, and which only show that software ran?", text: "I am interested in measurement validity, selection effects, causal evaluation, and reproducible workflows. Interaction logs and model judgments can be useful, but their interpretation depends on how they are collected and what is missing.", links:[{label:"LLM evaluation",href:"/projects/llm-evaluation-reliability/"},{label:"Learning analytics",href:"/projects/learning-analytics-value-chain/"},{label:"Research note",href:"/writing/interaction-logs/"}] }
];
---
<BaseLayout title="Research" description="Emerging research questions connecting societal computing, human-AI interaction, agent systems, and empirical evaluation.">
  <header class="page-hero"><p class="page-label">Research</p><h1>People, agents, and the systems between them</h1><p class="lede">My emerging research direction connects societal computing and computational social science with the design of interactive AI systems.</p><p>I am interested in a reciprocal relationship: building systems can make new research questions observable, while empirical research should change how those systems are designed. My current projects span learning, scientific workflows, and interactive social worlds.</p></header>
  <section class="research-directions">
    {questions.map((item,index) => <article><p class="page-label">Question {index+1}</p><h2>{item.title}</h2><p class="research-question">{item.question}</p><p>{item.text}</p><div class="inline-links">{item.links.map(link => <a href={link.href}>{link.label}</a>)}</div></article>)}
  </section>
  <section class="content-section">
    <h2>A working perspective</h2>
    <div class="prose"><p>I think about three connected parts of an AI-supported environment: <strong>interfaces and devices</strong> that make action possible, <strong>agents</strong> that interpret and respond, and <strong>human capabilities</strong> that develop through use. Evidence cuts across all three: it tells us whether an apparent improvement survives a different task, person, or setting.</p><p>This is a working lens for organizing my questions, not a validated theory. It helps me connect projects without treating medicine, education, or narrative as separate research identities.</p></div>
  </section>
  <section class="content-section"><h2>How I Work</h2><div class="method-grid">{methodGroups.map(group=><article><h3>{group.title}</h3><ul>{group.items.map(item=><li>{item}</li>)}</ul></article>)}</div></section>
</BaseLayout>
