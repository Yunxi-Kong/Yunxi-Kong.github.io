---
import BaseLayout from "../layouts/BaseLayout.astro";
import { methodGroups } from "../data/site";
const questions = [
  { title: "Individual capability", question: "How can AI expand what a person can understand and do without taking over the choice of goals?", text: "I want to study systems that combine memory, interactive understanding, and delegated action. The central distinction is between producing a better output and giving a person more useful options. Learning environments offer a setting for examining that distinction over time.", links: [{label:"The Cognitive Exoskeleton",href:"/writing/human-capability/"},{label:"Learning projects",href:"/projects/"}] },
  { title: "Collective action", question: "When does giving people more agents improve coordination, and when does it multiply the work of managing them?", text: "I am interested in information allocation, shared commitments, and the organization of human-agent teams. An agent's local success need not improve the group's outcome. Interactive worlds and carefully specified simulations offer ways to explore mechanisms before making claims about real social behavior.", links:[{label:"Simulation and evidence",href:"/writing/simulation-and-evidence/"},{label:"Motiverse",href:"/projects/motiverse/"}] },
  { title: "Institutions and opportunity", question: "When intelligence becomes cheaper, who gains the authority and resources to act on it?", text: "Better tools could widen access while concentrating control over infrastructure, context, and coordination. I want to connect system design to questions about incentives, dependency, organizational boundaries, and the distribution of benefits. This is a developing research agenda, not an established empirical finding.", links:[{label:"The Next Bottleneck",href:"/writing/the-next-bottleneck/"},{label:"Measurement questions",href:"/writing/interaction-logs/"}] }
];
---
<BaseLayout title="Research" description="Emerging research questions connecting societal computing, human-AI interaction, agent systems, and empirical evaluation.">
  <header class="page-hero"><p class="page-label">Research</p><h1>Human capability, from people to institutions</h1><p class="lede">I study and build toward a question: how can advances in AI become meaningful advances in people's ability to understand, choose, and act?</p><p>My developing agenda in societal computing and computational social science connects three scales. A person's tools shape how they collaborate; the organizations and institutions around them shape what those tools can make possible.</p></header>
  <section class="research-directions">
    {questions.map((item,index) => <article><p class="page-label">Question {index+1}</p><h2>{item.title}</h2><p class="research-question">{item.question}</p><p>{item.text}</p><div class="inline-links">{item.links.map(link => <a href={link.href}>{link.label}</a>)}</div></article>)}
  </section>
  <section class="content-section">
    <h2>Social science, AI, and engineering</h2>
    <div class="prose"><p><strong>Social science</strong> helps identify the constraints, incentives, and relationships behind a problem. <strong>AI</strong> makes new forms of assistance, action, and simulation possible. <strong>Engineering</strong> turns an idea into a working arrangement that people can use and researchers can examine.</p><p>These are complementary parts of my approach, not a claim to a new theory. Evaluation connects them: I want to test mechanisms and consequences, not infer social progress from a system's technical sophistication. My current projects provide places to start; the essays develop the questions I want to pursue next.</p></div>
  </section>
  <section class="content-section"><h2>How I Work</h2><div class="method-grid">{methodGroups.map(group=><article><h3>{group.title}</h3><ul>{group.items.map(item=><li>{item}</li>)}</ul></article>)}</div></section>
</BaseLayout>
