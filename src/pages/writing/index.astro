---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { writing } from "../../data/writing";
import { formatDate } from "../../data/site";
import "../../styles/writing.css";
---
<BaseLayout title="Writing" description="Essays and research notes by Yunxi Kong on human agency, AI, collective action, and societal computing.">
  <header class="page-hero notes-index-header"><p class="page-label">Writing</p><h1>Essays &amp; Research Notes</h1><p class="lede">What becomes possible for people when machines become more capable?</p><p class="muted">On understanding, agency, and the institutions we build around intelligence.</p></header>
  <div class="notes-index">{writing.map((post, index) => <article class="note-preview">
    <a class="note-preview-image" href={post.url} aria-label={post.title}>
      <img src={post.image.src} srcset={post.image.small ? `${post.image.small} 720w, ${post.image.src} 1440w` : undefined} sizes="(max-width: 760px) calc(100vw - 40px), 310px" alt={post.image.alt} width={post.image.width} height={post.image.height} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
    </a>
    <div>
      <p class="page-label">{post.kind} · {post.topic}</p>
      <h2><a href={post.url}>{post.title}</a></h2>
      <p>{post.description}</p>
      <p class="reading-meta"><time datetime={post.date}>{formatDate(post.date)}</time><span>{post.minutes} min read</span><a href={post.url} aria-label={`Read ${post.kind.toLowerCase()}: ${post.title}`}>Read {post.kind.toLowerCase()} <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </article>)}</div>
</BaseLayout>
