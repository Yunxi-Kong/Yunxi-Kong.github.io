---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { writing } from "../../data/writing";
import { formatDate } from "../../data/site";
import "../../styles/writing.css";
---
<BaseLayout title="Writing" description="Research notes by Yunxi Kong on human capability, agent simulation, and evidence in human-AI systems.">
  <header class="page-hero notes-index-header"><p class="page-label">Writing</p><h1>Research Notes</h1><p class="lede">Questions at the intersection of building AI systems and understanding their consequences.</p><p class="muted">Working perspectives and open questions, not reports of completed experiments.</p></header>
  <div class="notes-index">{writing.map((post, index) => <article class="note-preview">
    <a class="note-preview-image" href={post.url} aria-label={post.title}>
      <img src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
    </a>
    <div>
      <p class="page-label">{post.topic}</p>
      <h2><a href={post.url}>{post.title}</a></h2>
      <p>{post.description}</p>
      <p class="reading-meta"><time datetime={post.date}>{formatDate(post.date)}</time><span>{post.minutes} min read</span><a href={post.url} aria-label={`Read note: ${post.title}`}>Read note <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </article>)}</div>
</BaseLayout>
