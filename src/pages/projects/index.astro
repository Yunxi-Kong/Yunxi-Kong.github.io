---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="Projects" description="Research systems and empirical projects by Yunxi Kong, including ASNR Brain Atlas, Motiverse, CyberNeuro, and LLM evaluation.">
  <header class="page-hero"><p class="page-label">Projects</p><h1>Research &amp; Systems</h1><p class="lede">Interactive systems, agent workflows, and empirical studies.</p></header>
  <section class="content-section first-section"><h2>Recent Work</h2><div class="project-grid">{projects.slice(0,5).map(project=><ProjectCard project={project} />)}</div></section>
  <section class="content-section"><h2>Earlier Projects</h2><div class="project-grid">{projects.slice(5).map(project=><ProjectCard project={project} compact />)}</div></section>
</BaseLayout>
