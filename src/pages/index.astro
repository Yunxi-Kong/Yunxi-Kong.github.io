---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PublicationItem from "../components/PublicationItem.astro";
import { featuredProjects } from "../data/projects";
import { publications } from "../data/publications";
import { education, news, profile, researchInterests } from "../data/site";
import { writing } from "../data/writing";
---
<BaseLayout title="Yunxi Kong" description="Yunxi Kong is a research assistant at UNC ACMLab exploring societal computing, human-AI interaction, and computational social science.">
  <section class="hero-section">
    <aside class="portrait-panel" aria-label="Portrait and contact">
      <img src={profile.portrait} width="1280" height="1920" fetchpriority="high" alt="Yunxi Kong at Duke University" />
      <div class="portrait-contact">
        <p class="profile-name">Yunxi Kong</p>
        <p>{profile.role}<br />UNC Chapel Hill</p>
        <p class="email-text">{profile.email}</p>
        <div class="inline-links"><a href={profile.github}>GitHub</a><a href={profile.linkedin}>LinkedIn</a><a href="/cv/">CV</a></div>
      </div>
    </aside>
    <div class="hero-copy">
      <h1>About Me</h1>
      <p>I am a Research Assistant at the <a href={profile.lab}>Advanced Computational Medicine Laboratory</a> at the University of North Carolina at Chapel Hill, working with <a href="https://www.acmlab.org/">Prof. Guorong (Rudy) Wu</a>. I completed my M.S. in Economics and Computation at Duke University in May 2026, following undergraduate study in economics and mathematics at Syracuse University.</p>
      <p>I am interested in <strong>what becomes possible for people as AI becomes more capable</strong>. Better answers are part of that story, but so are the ability to act on them, coordinate with others, and choose which goals to pursue. These questions draw me toward societal computing, computational social science, and human-AI interaction.</p>
      <p>My approach connects <strong>social science, AI, and engineering</strong>: understand the constraints people face, build systems that could change them, and study what actually changes. My current work includes interactive learning environments, scientific tools, and multi-agent worlds.</p>
      <p>I am preparing for doctoral research. My <a href="/research/">research agenda</a> connects individual capability with collective action; in <a href="/writing/">my essays</a>, I explore the larger questions behind the systems I build.</p>
      <p class="interest-line">{researchInterests.join(" · ")}</p>
      <div class="inline-links hero-actions"><a href="/research/">Research questions</a><a href="/projects/">Projects</a><a href="/writing/">Writing</a></div>
    </div>
  </section>

  <section class="home-overview" aria-label="News and education">
    <div>
      <h2>News</h2>
      <div class="news-list">
        {news.map((item) => <article><time datetime={item.date}>{item.date}</time><p><a href={item.href}>{item.text}</a></p></article>)}
      </div>
    </div>
    <div>
      <h2>Education &amp; Training</h2>
      <div class="education-list">
        {education.map((item) => (
          <article class="education-item">
            <div class="school-logo"><img src={item.logo} alt={item.logoAlt} width="76" height="52" loading="lazy" /></div>
            <div><h3>{item.institution}</h3><p>{item.degree}</p><time>{item.period}</time></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section" aria-labelledby="selected-projects">
    <div class="section-heading"><h2 id="selected-projects">Selected Projects</h2><a href="/projects/">All projects</a></div>
    <div class="selected-work-list">{featuredProjects.map((project) => <ProjectCard project={project} compact />)}</div>
  </section>
  <section class="content-section" aria-labelledby="publications">
    <div class="section-heading"><h2 id="publications">Publications &amp; Preprints</h2><a href="/publications/">Full references</a></div>
    <div class="publication-list">{publications.map((publication) => <PublicationItem publication={publication} />)}</div>
  </section>
  <section class="content-section" aria-labelledby="writing">
    <div class="section-heading"><h2 id="writing">Selected Writing</h2><a href="/writing/">All writing</a></div>
    <div class="writing-list">{writing.slice(0,3).map((post) => <article><div class="card-meta">{post.kind} · {post.topic}</div><h3><a href={post.url}>{post.title}</a></h3><p>{post.description}</p></article>)}</div>
  </section>
  <section class="content-section contact-section" id="contact">
    <h2>Elsewhere</h2>
    <p>For my education technology work in China, visit <a href={profile.edtech}>Ingenius Prime</a>. More about my path is on the <a href="/about/">About page</a>.</p>
    <p class="contact-line">Contact: <span class="email-text">{profile.email}</span></p>
  </section>
</BaseLayout>
